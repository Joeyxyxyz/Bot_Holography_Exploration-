theorem OGR93.reconstruction_linear
    (p₁ p₂ : OGR93.Field)
    (h₁ : Integrable p₁ volume)
    (h₂ : Integrable p₂ volume) :
    OGR93.reconstruction (fun x => p₁ x + p₂ x) =
    fun w => OGR93.reconstruction p₁ w + OGR93.reconstruction p₂ w := by
      -- By the linearity of the Fourier transform, we can split the integral into the sum of two integrals.
      have h_fourier_linear : ∀ (f g : OGR93.Plane → ℂ), MeasureTheory.Integrable f MeasureTheory.volume → MeasureTheory.Integrable g MeasureTheory.volume → Real.fourierIntegral (f + g) = Real.fourierIntegral f + Real.fourierIntegral g := by
        intros f g hf hg; ext; simp [Real.fourierIntegral]; (
        simp +decide [ VectorFourier.fourierIntegral ];
        rw [ MeasureTheory.integral_add ];
        · refine' hf.norm.mono' _ _;
          · refine' MeasureTheory.AEStronglyMeasurable.smul _ hf.1;
            refine' Continuous.aestronglyMeasurable _;
            exact Continuous.comp ( Real.continuous_fourierChar ) ( Continuous.neg ( continuous_id.inner continuous_const ) );
          · norm_num [ Real.fourierChar ];
        · refine' hg.norm.mono' _ _;
          · refine' MeasureTheory.AEStronglyMeasurable.smul _ hg.1;
            refine' Continuous.aestronglyMeasurable _;
            exact Continuous.comp ( Real.continuous_fourierChar ) ( Continuous.neg ( continuous_id.inner continuous_const ) );
          · norm_num [ Real.fourierChar ]);
      exact h_fourier_linear p₁ p₂ h₁ h₂

def OGR93.AreComplementary (A_on A_off A_full : OGR93.Field) : Prop :=
  ∀ p : OGR93.Plane, A_on p + A_off p = A_full p

theorem OGR93.babinet_principle
    (A_on A_off A_full : OGR93.Field)
    (h_comp : OGR93.AreComplementary A_on A_off A_full)
    (h_int_on  : Integrable A_on  volume)
    (h_int_off : Integrable A_off volume) :
    ∀ w : OGR93.Plane,
      Real.fourierIntegral A_on w +
      Real.fourierIntegral A_off w =
      Real.fourierIntegral A_full w := by
        -- Since A_on and A_off are complementary, their sum is A_full, and thus their Fourier transforms add up to the Fourier transform of A_full.
        have h_sum : ∀ w, (Real.fourierIntegral (A_on + A_off) w) = (Real.fourierIntegral A_full w) := by
          -- Since $A_{on}$ and $A_{off}$ are complementary, their sum is $A_{full}$ by definition.
          have h_sum : A_on + A_off = A_full := by
            exact?;
          aesop;
        simp_all +decide [ Real.fourierIntegral ];
        simp_all +decide [ VectorFourier.fourierIntegral, MeasureTheory.integral_add ]

theorem OGR93.off_mirrors_determined
    (A_on A_off A_full : OGR93.Field)
    (h_comp : OGR93.AreComplementary A_on A_off A_full)
    (h_int_on  : Integrable A_on  volume)
    (h_int_off : Integrable A_off volume) :
    ∀ w : OGR93.Plane,
      Real.fourierIntegral A_off w =
      Real.fourierIntegral A_full w -
      Real.fourierIntegral A_on w := by
        intro w
        have h_sum : A_off = A_full - A_on := by
          -- By definition of complementary fields, we have A_on + A_off = A_full.
          have h_sum : A_on + A_off = A_full := by
            exact?;
          -- By subtracting $A_{on}$ from both sides of $A_{on} + A_{off} = A_{full}$, we get $A_{off} = A_{full} - A_{on}$.
          rw [←h_sum]
          simp;
        rw [ h_sum, Real.fourierIntegral, Real.fourierIntegral, Real.fourierIntegral ];
        rw [ VectorFourier.fourierIntegral, VectorFourier.fourierIntegral, VectorFourier.fourierIntegral ];
        rw [ ← MeasureTheory.integral_sub ] ; congr ; ext ; norm_num [ smul_sub ] ;
        · refine' MeasureTheory.Integrable.mono' _ _ _;
          refine' fun v => ‖A_full v‖;
          · exact MeasureTheory.Integrable.norm ( by simpa [ h_sum ] using h_int_off.add h_int_on );
          · refine' MeasureTheory.AEStronglyMeasurable.smul _ _;
            · refine' Continuous.aestronglyMeasurable _;
              exact Continuous.comp ( Real.continuous_fourierChar ) ( Continuous.neg ( continuous_id.inner continuous_const ) );
            · exact MeasureTheory.Integrable.aestronglyMeasurable ( by rw [ show A_full = A_off + A_on by rw [ h_sum, sub_add_cancel ] ] ; exact h_int_off.add h_int_on );
          · norm_num [ Real.fourierChar ];
        · refine' h_int_on.norm.mono' _ _;
          · refine' MeasureTheory.AEStronglyMeasurable.smul _ h_int_on.1;
            refine' Continuous.aestronglyMeasurable _;
            exact Continuous.comp ( Real.continuous_fourierChar ) ( Continuous.neg ( continuous_id.inner continuous_const ) );
          · norm_num [ Real.fourierChar ]

def OGR93.DiagDir : OGR93.Plane := ![1, 1]    -- stripe direction
def OGR93.PerpDir : OGR93.Plane := ![1, -1]   -- perpendicular to stripe

theorem OGR93.diag_perp_orthogonal :
    inner (𝕜 := ℝ) OGR93.DiagDir OGR93.PerpDir = (0 : ℝ) := by
      -- By definition of inner product, we have:
      simp [OGR93.DiagDir, OGR93.PerpDir, inner]

def OGR93.ReferenceLine : Set OGR93.Plane :=
  { w | inner (𝕜 := ℝ) OGR93.DiagDir w = 0 }

def OGR93.PosDepth : Set OGR93.Plane :=
  { p | inner (𝕜 := ℝ) OGR93.PerpDir p > 0 }

def OGR93.NegDepth : Set OGR93.Plane :=
  { p | inner (𝕜 := ℝ) OGR93.PerpDir p < 0 }

theorem OGR93.reference_line_is_perp_span :
    OGR93.ReferenceLine = { w | ∃ c : ℝ, w = c • OGR93.PerpDir } := by
      -- To prove equality of sets, we show each set is a subset of the other.
      apply Set.ext
      intro w
      simp [OGR93.ReferenceLine, OGR93.PerpDir];
      -- By definition of inner product, we have ⟪OGR93.DiagDir, w⟫_ℝ = w 0 + w 1.
      simp [OGR93.DiagDir, inner];
      -- If $w 0 + w 1 = 0$, then $w 1 = -w 0$. We can choose $c = w 0$ to satisfy $w = c • ![1, -1]$.
      apply Iff.intro
      intro h
      use w 0
      ext i
      fin_cases i <;> simp [h];
      · linarith;
      · aesop

structure OGR93.CompositePattern where
  glyph_aperture  : OGR93.Field   -- ON mirror pattern encoding glyph
  stripe_aperture : OGR93.Field   -- OFF mirror diagonal stripe
  combined        : OGR93.Field   -- their sum
  h_sum : ∀ x, combined x = glyph_aperture x + stripe_aperture x
  -- Both components are integrable
  h_int_glyph  : Integrable glyph_aperture  volume
  h_int_stripe : Integrable stripe_aperture volume

theorem OGR93.composite_superposition
    (cp : OGR93.CompositePattern) :
    OGR93.reconstruction cp.combined =
    fun w => OGR93.reconstruction cp.glyph_aperture w +
             OGR93.reconstruction cp.stripe_aperture w := by
               apply funext; intro w; exact (by
               convert congr_fun ( OGR93.reconstruction_linear _ _ _ _ ) w using 1;
               · congr! 2;
                 exact?;
               · exact?;
               · exact?)

theorem OGR93.composite_reconstruction_splits
    (cp : OGR93.CompositePattern) :
    ∀ w : OGR93.Plane,
      OGR93.reconstruction cp.combined w =
      OGR93.reconstruction cp.glyph_aperture w +
      OGR93.reconstruction cp.stripe_aperture w := by
        -- By the linearity of the Fourier transform, we can split the reconstruction into the sum of the individual reconstructions. Hence, we have:
        intros w
        apply congr_fun (OGR93.composite_superposition cp) w

theorem OGR93.glyph_plus_reference_theorem
    (target_glyph  : OGR93.Field)
    (stripe_field  : OGR93.Field)     -- F[diagonal_stripe]
    (h_glyph_cont  : Continuous target_glyph)
    (h_glyph_int   : Integrable target_glyph volume)
    (h_glyph_ft    : Integrable (Real.fourierIntegral target_glyph) volume)
    (h_stripe_int  : Integrable (Real.fourierIntegralInv target_glyph) volume)
    (h_stripe_int2 : Integrable stripe_field volume) :
    -- The pattern = F⁻¹[glyph] (encodes target glyph)
    let glyph_pattern := Real.fourierIntegralInv target_glyph
    -- The combined reconstruction recovers the glyph
    OGR93.reconstruction glyph_pattern = target_glyph := by
      -- Apply the glyph_reconstruction_theorem with the given hypotheses.
      apply OGR93.glyph_reconstruction_theorem target_glyph h_glyph_cont h_glyph_int h_glyph_ft

theorem OGR93.reference_line_contribution_exists
    (stripe : OGR93.Field)
    (h_int : Integrable stripe volume) :
    ∃ ref : OGR93.Field,
      ref = OGR93.reconstruction stripe ∧
      Integrable (OGR93.reconstruction stripe) volume → True := by
        -- The Fourier transform of an integrable function is continuous and bounded, hence integrable.
        use OGR93.reconstruction stripe; simp [h_int]

