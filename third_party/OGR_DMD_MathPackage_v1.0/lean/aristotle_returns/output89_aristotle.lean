/-
Formalization of NLoS projection duality.
We define the Hadamard matrix recursively and prove its orthogonality and inversion properties.
We then define the NLoS scattering and reconstruction operators and prove their duality.
Finally, we define the nullification and remainder operators and prove the conservation law N + R = I.
-/

import Mathlib

set_option linter.mathlibStandardSet false

open scoped BigOperators
open scoped Real
open scoped Nat
open scoped Classical
open scoped Pointwise

set_option maxHeartbeats 0
set_option maxRecDepth 4000
set_option synthInstance.maxHeartbeats 20000
set_option synthInstance.maxSize 128

set_option relaxedAutoImplicit false
set_option autoImplicit false

noncomputable section

/-
Definition of the Hadamard matrix of order 2^n using the Sylvester construction.
-/
def hadamard (n : ℕ) : Matrix (Fin (2^n)) (Fin (2^n)) ℝ :=
  match n with
  | 0 => !![1]
  | n + 1 =>
    let H := hadamard n
    let H_blocks := Matrix.fromBlocks H H H (-H)
    let h : 2^n + 2^n = 2^(n+1) := by ring
    let e : Fin (2^n) ⊕ Fin (2^n) ≃ Fin (2^(n+1)) :=
      (finSumFinEquiv (m := 2^n) (n := 2^n)).trans (finCongr h)
    Matrix.reindex e e H_blocks

/-
The Hadamard matrix of order 2^n satisfies H * H^T = 2^n * I.
-/
theorem hadamard_mul_transpose (n : ℕ) :
  (hadamard n) * (hadamard n).transpose = (2^n : ℝ) • (1 : Matrix (Fin (2^n)) (Fin (2^n)) ℝ) := by
  induction n <;> simp_all +decide [ pow_succ, Matrix.mul_assoc ];
  · ext i j ; fin_cases i ; fin_cases j ; norm_num [ hadamard ];
    rfl;
  · -- By definition of Hadamard matrix, we have:
    have h_hadamard_succ : ∀ n, hadamard (n + 1) = Matrix.reindex (finSumFinEquiv.trans (finCongr (by ring : 2 ^ n + 2 ^ n = 2 ^ (n + 1)))) (finSumFinEquiv.trans (finCongr (by ring : 2 ^ n + 2 ^ n = 2 ^ (n + 1)))) (Matrix.fromBlocks (hadamard n) (hadamard n) (hadamard n) (-hadamard n)) := by
      exact?;
    simp_all +decide [ Matrix.fromBlocks_transpose, Matrix.fromBlocks_multiply ];
    ext i j; simp +decide [ Matrix.one_apply, Matrix.smul_eq_diagonal_mul ] ; ring;
    split_ifs <;> simp_all +decide [ Fin.ext_iff, Matrix.diagonal ]

/-
The inverse of the Hadamard matrix of order 2^n is (1/2^n) * H^T.
-/
theorem hadamard_inv (n : ℕ) :
  (hadamard n)⁻¹ = (1 / (2^n : ℝ)) • (hadamard n).transpose := by
  -- Since H is invertible, we can multiply both sides of the equation H * H^T = 2^n * I by H⁻¹ on the left to get H^T = 2^n * H⁻¹.
  have h_inv : (hadamard n) * (hadamard n).transpose = (2^n : ℝ) • (1 : Matrix (Fin (2^n)) (Fin (2^n)) ℝ) := by
    exact?;
  rw [ Matrix.inv_eq_right_inv ] ; aesop

/-
Checking for the existence of smul_smul and Matrix.mul_smul.
-/
#check smul_smul
#check Matrix.mul_smul

/-
The product of the Hadamard matrix and its inverse is the identity matrix.
-/
theorem hadamard_mul_inv (n : ℕ) :
  (hadamard n) * (hadamard n)⁻¹ = 1 := by
  rw [hadamard_inv]
  rw [Matrix.mul_smul]
  rw [hadamard_mul_transpose]
  rw [smul_smul]
  norm_num

/-
NLoS scattering and reconstruction are dual operations: scattering the reconstructed field recovers the original field.
-/
def nlos_scattering (n : ℕ) (φ : Fin (2^n) → ℝ) : Fin (2^n) → ℝ :=
  Matrix.mulVec (hadamard n) φ

def nlos_reconstruction (n : ℕ) (ψ : Fin (2^n) → ℝ) : Fin (2^n) → ℝ :=
  Matrix.mulVec (hadamard n)⁻¹ ψ

theorem nlos_duality (n : ℕ) (ψ : Fin (2^n) → ℝ) :
  nlos_scattering n (nlos_reconstruction n ψ) = ψ := by
  dsimp [nlos_scattering, nlos_reconstruction]
  rw [Matrix.mulVec_mulVec]
  rw [hadamard_mul_inv]
  rw [Matrix.one_mulVec]

/-
The conservation law N + R = I holds for the NLoS operators.
-/
def N_operator (n : ℕ) : Matrix (Fin (2^n)) (Fin (2^n)) ℝ :=
  (hadamard n) * (hadamard n)⁻¹

def R_operator (n : ℕ) : Matrix (Fin (2^n)) (Fin (2^n)) ℝ :=
  1 - N_operator n

theorem conservation_law (n : ℕ) :
  N_operator n + R_operator n = 1 := by
    unfold N_operator R_operator;
    unfold N_operator;
    rw [ add_sub_cancel ]

/-
The conservation law N + R = I holds for the NLoS operators.
-/
theorem nlos_conservation_law (n : ℕ) :
  N_operator n + R_operator n = 1 := by
  dsimp [R_operator]
  rw [add_comm]
  rw [sub_add_cancel]