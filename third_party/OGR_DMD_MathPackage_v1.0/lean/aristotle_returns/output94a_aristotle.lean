      Real.fourierIntegral U_ref w +
      Real.fourierIntegral U_obj w := by
        unfold Real.fourierIntegral OGR94.TwoDMDField;
        intro w; rw [ VectorFourier.fourierIntegral, VectorFourier.fourierIntegral, VectorFourier.fourierIntegral ] ; simp +decide [ MeasureTheory.integral_add, * ] ;

