/-- Off-axis separation condition. -/
def OGR94.OffAxisCondition (f_c B_glyph : ℝ) : Prop :=
  f_c ≥ (3 / 2) * B_glyph

/-- [FIXED] If off-axis condition holds, glyph at f_c doesn't overlap DC (assumed width B/2). -/
theorem OGR94.glyph_separated_from_dc
