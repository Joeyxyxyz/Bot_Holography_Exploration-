    Disjoint OGR94.PosDepth94 OGR94.NegDepth94 := by
      exact ⟨ Set.eq_univ_of_forall fun x => by cases lt_trichotomy ( ⟪OGR94.PerpDir, x⟫_ℝ ) 0 <;> aesop, Set.disjoint_left.2 fun x hx hx' => hx'.out.ne' hx, Set.disjoint_left.2 fun x hx hx' => hx'.out.ne hx, Set.disjoint_left.2 fun x hx hx' => hx'.out.not_lt hx ⟩

