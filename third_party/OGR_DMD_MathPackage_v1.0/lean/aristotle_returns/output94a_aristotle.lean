    (H : OGR94.Field) (h_unit : OGR94.UnitAmplitude H) (f_c : ℝ)
    (p : OGR94.Plane) :
    OGR94.lee_aperture H f_c p = 0 ∨
    OGR94.lee_aperture H f_c p = 1 :=
  OGR94.lee_is_binary H f_c p

