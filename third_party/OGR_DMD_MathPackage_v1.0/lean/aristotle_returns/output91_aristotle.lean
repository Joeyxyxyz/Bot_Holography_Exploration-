noncomputable section

/-
Babinet's principle states that the Fourier transform of complementary apertures sums to the Fourier transform of the full aperture.
If A_on + A_off = A_full, then F[A_on] + F[A_off] = F[A_full].
-/
open MeasureTheory Real Complex Set Filter
open scoped Real InnerProductSpace


-- Define the 2D plane
abbrev Plane := EuclideanSpace ℝ (Fin 2)

-- Define an aperture as a function from the plane to complex numbers
def Aperture := Plane → ℂ

-- Define what it means for two apertures to be complementary with respect to a full aperture
def AreComplementary (A_on A_off A_full : Aperture) : Prop :=
  ∀ p : Plane, A_on p + A_off p = A_full p

-- Claim B: Babinet's Principle
-- The Fourier transform of the sum is the sum of the Fourier transforms.
-- This implies that if A_on + A_off = A_full, then F[A_on] + F[A_off] = F[A_full].
theorem babinet_principle (A_on A_off A_full : Aperture)
    (h_comp : AreComplementary A_on A_off A_full)
    (h_int_on : Integrable A_on)
    (h_int_off : Integrable A_off) :
    ∀ w : Plane, Real.fourierIntegral A_on w + Real.fourierIntegral A_off w = Real.fourierIntegral A_full w := by
  unfold AreComplementary at h_comp;
  unfold Real.fourierIntegral;
  simp +decide [ ← h_comp, VectorFourier.fourierIntegral ];
  intro w; rw [ MeasureTheory.integral_add ] ; aesop;
  refine' h_int_off.norm.mono' _ _;
  · refine' MeasureTheory.AEStronglyMeasurable.smul _ h_int_off.aestronglyMeasurable;
    refine' Continuous.aestronglyMeasurable _;
    exact Continuous.comp ( Real.continuous_fourierChar ) ( Continuous.neg ( continuous_id.inner continuous_const ) );
  · norm_num [ Real.fourierChar ]

/-
The diagonal direction (1, 1) and the perpendicular direction (1, -1) are orthogonal.
-/
open MeasureTheory Real Complex Set Filter
open scoped Real InnerProductSpace


-- Define the diagonal direction (45 degrees)
def DiagonalDirection : Plane := ![1, 1]

-- Define the direction of the stripe (along the diagonal)
def StripeDirection : Plane := DiagonalDirection

-- Define the direction perpendicular to the stripe
def PerpendicularDirection : Plane := ![1, -1]

-- Claim C: Diagonal Zero-Line as Depth Reference
-- Part 1: The perpendicular direction is indeed orthogonal to the stripe direction.
theorem diagonal_stripe_geometry :
    inner (𝕜 := ℝ) StripeDirection PerpendicularDirection = (0 : ℝ) := by
  -- By definition of inner product, we have:
  simp [StripeDirection, PerpendicularDirection];
  norm_num [ DiagonalDirection, inner ]

/-
The reference line, defined as the set of points orthogonal to the stripe direction, is exactly the line spanned by the perpendicular direction.
-/
open MeasureTheory Real Complex Set Filter
open scoped Real InnerProductSpace


-- Define the "z = 0" reference line in the reconstruction plane
def ReferenceLine : Set Plane := { w | inner (𝕜 := ℝ) StripeDirection w = 0 }

-- Define "Above Diagonal" for depth encoding
-- Assuming "above" means to one side of the diagonal line $x = y$, i.e., $y > x$ or $y - x > 0$.
-- The normal to the line $x = y$ is $(-1, 1)$ or $(1, -1)$.
-- Let's use the PerpendicularDirection which is $(1, -1)$.
-- inner PerpendicularDirection p = p.0 - p.1.
-- If this is positive, $x > y$. If negative, $x < y$.
-- Let's define "Positive Depth" as being on one side.
def IsPositiveDepth (p : Plane) : Prop := inner (𝕜 := ℝ) PerpendicularDirection p > 0

-- Theorem: The Reference Line separates positive and negative depth (geometric triviality)
-- Actually, the claim says "A diagonal stripe of all-0 (OFF) mirrors produces a Fourier transform that is a LINE PERPENDICULAR to the stripe direction."
-- So the Fourier transform of the stripe is the Reference Line.
-- And "This perpendicular line appears in the reconstruction plane as a hard phase boundary — the BUILT-IN z = 0 REFERENCE LINE."
-- So the Reference Line is indeed the line perpendicular to the stripe.
-- The claim also says "Mirrors 'above' diagonal → encode z > 0 content (positive depth)".
-- This suggests that the spatial domain is divided by the diagonal, and this corresponds to depth.
-- But the Reference Line is in the Fourier domain (reconstruction plane).
-- Wait, the claim says "This perpendicular line appears in the reconstruction plane as a hard phase boundary".
-- So the Reference Line is in the reconstruction plane.
-- And "Mirrors 'above' diagonal" refers to the DMD plane (spatial domain).
-- So the depth encoding is in the spatial domain, but the reference is in the Fourier domain.
-- The claim seems to be mixing domains or implying a correspondence.
-- "A diagonal stripe ... produces a Fourier transform that is a LINE PERPENDICULAR to the stripe direction."
-- This is a standard property of Fourier transforms: FT of a line is a line perpendicular to it.
-- Let's formalize this property: The support of the Fourier transform of a function supported on a line is the perpendicular line.
-- Or rather, the FT of a delta function on a line is a delta function on the perpendicular line?
-- No, the FT of a line (constant on the line, zero elsewhere) is a delta function on the perpendicular line.
-- But a "diagonal stripe of all-0 (OFF) mirrors" implies a gap in the pattern.
-- If we have a full aperture minus a diagonal stripe, by Babinet, the field is F[Full] - F[Stripe].
-- F[Full] is a delta at 0 (DC term).
-- F[Stripe] is a line perpendicular to the stripe.
-- So the field is a delta at 0 minus a line.
-- This line is the "z = 0 reference line".
-- So the claim is about the geometry of this line.
-- I will stick to the geometric part for now: The line perpendicular to the stripe is the reference line.
-- And I will formalize the "depth encoding" part as a definition on the spatial domain.

theorem reference_line_is_perpendicular :
    ReferenceLine = { w | ∃ (c : ℝ), w = c • PerpendicularDirection } := by
  ext w; simp [ReferenceLine];
  constructor <;> intro h <;> unfold StripeDirection PerpendicularDirection at *;
  · norm_num [ DiagonalDirection, inner ] at h;
    use w 0; ext i; fin_cases i <;> norm_num <;> linarith!;
  · obtain ⟨ c, rfl ⟩ := h; norm_num [ DiagonalDirection, inner_smul_right ] ;
    norm_num [ Fin.sum_univ_succ, inner ]

/-
The spatial plane is partitioned into the Stripe (where the inner product with the perpendicular direction is 0), the Positive Depth region (where it is positive), and the Negative Depth region (where it is negative).
-/
open MeasureTheory Real Complex Set Filter
open scoped Real InnerProductSpace


-- Define the spatial regions
def SpatialStripe : Set Plane := { p | inner (𝕜 := ℝ) PerpendicularDirection p = 0 }
def SpatialPositiveDepth : Set Plane := { p | inner (𝕜 := ℝ) PerpendicularDirection p > 0 }
def SpatialNegativeDepth : Set Plane := { p | inner (𝕜 := ℝ) PerpendicularDirection p < 0 }

-- Theorem: The spatial plane is partitioned into the Stripe, Positive Depth, and Negative Depth regions.
theorem spatial_depth_partition :
    (SpatialStripe ∪ SpatialPositiveDepth ∪ SpatialNegativeDepth) = univ ∧
    Disjoint SpatialStripe SpatialPositiveDepth ∧
    Disjoint SpatialStripe SpatialNegativeDepth ∧
    Disjoint SpatialPositiveDepth SpatialNegativeDepth := by
  unfold SpatialStripe SpatialPositiveDepth SpatialNegativeDepth;
  norm_num [ Set.disjoint_left ];
  exact ⟨ Set.eq_univ_of_forall fun p => by rcases lt_trichotomy ( ⟪PerpendicularDirection, p⟫_ℝ ) 0 with h | h | h <;> aesop, fun p hp => by linarith, fun p hp => by linarith, fun p hp => by linarith ⟩

/-
Given that resolution width is inversely proportional to aperture size, a larger wall aperture results in a finer (smaller) resolution width compared to a smaller DMD aperture.
-/
open MeasureTheory Real Complex Set Filter
open scoped Real InnerProductSpace


-- Define Aperture Size and Resolution Width
-- We assume a simple inverse relationship: ResolutionWidth = k / ApertureSize
-- where k is a positive constant (related to wavelength, focal length, etc.)

def ResolutionWidth (k : ℝ) (ApertureSize : ℝ) : ℝ := k / ApertureSize

-- Claim A (ii): The wall aperture >> DMD aperture → finer reconstruction resolution
theorem wall_bounce_resolution (k : ℝ) (WallApertureSize DMDApertureSize : ℝ)
    (hk : k > 0)
    (h_sizes_pos : WallApertureSize > 0 ∧ DMDApertureSize > 0)
    (h_larger : WallApertureSize > DMDApertureSize) :
    ResolutionWidth k WallApertureSize < ResolutionWidth k DMDApertureSize := by
  exact div_lt_div_of_pos_left hk h_sizes_pos.2 h_larger |> fun h => by unfold ResolutionWidth at *; linarith;

/-
We model the optical system with properties for scattering and source incoherence.
Effective spatial coherence is modeled as increasing with scattering.
Corrected incoherence is modeled as decreasing with scattering.
Comparing a direct system (no scattering) with a wall bounce system (positive scattering), the wall bounce system has higher effective spatial coherence and lower corrected incoherence.
-/
open MeasureTheory Real Complex Set Filter
open scoped Real InnerProductSpace


-- Define abstract properties for the optical system
structure OpticalSystem where
  SourceIncoherence : ℝ
  WallScattering : ℝ
  EffectiveSpatialCoherence : ℝ
  -- Constraints based on the claims
  h_scattering_pos : WallScattering > 0
  h_incoherence_pos : SourceIncoherence > 0
  -- Claim A (i): Diffusion (Scattering) leads to increased effective spatial coherence
  -- We model this as: Coherence is a strictly increasing function of Scattering
  h_coherence_scattering_relation : ∀ (s1 s2 : ℝ), s1 < s2 → (s1 * SourceIncoherence) < (s2 * SourceIncoherence) -- This is just a dummy relation, need something better.
  -- Let's assume Coherence = f(Scattering) where f is strictly increasing.
  -- And let's assume "Direct DMD" has Scattering = 0 (or low), and "Wall" has Scattering = High.

-- Let's refine the model.
-- We are comparing two systems: DirectDMD and WallBounce.

structure SystemState where
  Scattering : ℝ
  SourceIncoherence : ℝ

def EffectiveSpatialCoherence (state : SystemState) : ℝ :=
  -- Model: Coherence increases with Scattering (Claim A i)
  -- and is inversely related to SourceIncoherence (Claim A iii suggests correction)
  -- Let's say Coherence = Scattering / SourceIncoherence (just a model)
  state.Scattering -- Simplified: The claim says "The wall diffuses... -> increased coherence".

def CorrectedIncoherence (state : SystemState) : ℝ :=
  -- Model: Incoherence is corrected by scattering.
  -- Corrected = Source - Scattering (clamped to 0)
  max 0 (state.SourceIncoherence - state.Scattering)

-- Claim A (i) and (iii)
theorem wall_bounce_advantages (Direct Wall : SystemState)
    (h_direct_scattering : Direct.Scattering = 0)
    (h_wall_scattering : Wall.Scattering > 0)
    (h_same_source : Direct.SourceIncoherence = Wall.SourceIncoherence)
    (h_source_pos : Direct.SourceIncoherence > 0)
    -- Assumption: Wall scattering is not too large to completely eliminate incoherence (optional)
    (h_partial_correction : Wall.Scattering < Wall.SourceIncoherence) :
    EffectiveSpatialCoherence Wall > EffectiveSpatialCoherence Direct ∧
    CorrectedIncoherence Wall < CorrectedIncoherence Direct := by
  unfold EffectiveSpatialCoherence CorrectedIncoherence at * ; aesop;