    The right is the mirror of the left under the functional equation. -/
theorem speiser_right (h_speiser : ∀ s : ℂ, s ∈ LeftCriticalStrip → deriv riemannZeta s ≠ 0)
    (ρ : ℂ) (hρ : is_nontrivial_zero ρ) (h_right : ρ.re > 1/2) :
    deriv riemannZeta ρ ≠ 0 := by
  contrapose! h_speiser;
  -- By the functional equation, if ρ is a zero, then 1 - ρ is also a zero. Since ρ is in the right half-strip, 1 - ρ will be in the left half-strip.
  have h_func_eq : deriv riemannZeta (1 - ρ) = 0 := by
    convert func_eq_deriv ρ hρ |>.2 h_speiser using 1;
  exact ⟨ 1 - ρ, ⟨ by norm_num; linarith [ hρ.2.1, hρ.2.2 ], by norm_num; linarith [ hρ.2.1, hρ.2.2 ] ⟩, h_func_eq ⟩

#check func_eq_deriv
#check speiser_right

