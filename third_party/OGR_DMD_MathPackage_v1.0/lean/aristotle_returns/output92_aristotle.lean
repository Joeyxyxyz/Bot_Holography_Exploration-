/-
Formalization of Signed Depth-Plane Multiplexing claims.

This module formalizes the key mathematical claims regarding the separation of depth layers in a holographic display using signed depth-plane multiplexing.

Key definitions and theorems:
- `dft2`: 2D Discrete Fourier Transform on `ZMod N × ZMod N`.
- `supported_on`: Predicate for a function's support being contained in a region.
- `disjoint_supports_implies_zero_sum` (Claim A): Proves that signals from the positive depth layer (above diagonal), negative depth layer (below diagonal), and zero layer (diagonal) are algebraically distinct and linearly independent.
- `babinet_principle` (Claim B): Establishes the complementary nature of the ON and OFF mirror states in the Fourier domain.
- `dft_diagonal_is_anti_diagonal` (Claim C): Proves that the diagonal zero-line in the spatial domain corresponds to a hard phase boundary (anti-diagonal) in the frequency domain, separating the positive and negative depth information.
- `signed_spectral_gap` (Claim D): Demonstrates that as long as the content (magnitude sum) of the positive and negative layers differs, they cannot fully cancel each other out, ensuring resolvability.
-/

import Mathlib

set_option linter.mathlibStandardSet false

open scoped BigOperators
open scoped Real
open scoped Nat
open scoped Classical
open scoped Pointwise

set_option maxHeartbeats 0
set_option maxRecDepth 4000
set_option synthInstance.maxHeartbeats 20000
set_option synthInstance.maxSize 128

set_option relaxedAutoImplicit false
set_option autoImplicit false

noncomputable section

/-
Definition of 2D Discrete Fourier Transform on a grid ZMod N x ZMod N.
-/
def dft2 {N : ℕ} [NeZero N] (f : ZMod N × ZMod N → ℂ) (k : ZMod N × ZMod N) : ℂ :=
  ∑ x : ZMod N × ZMod N, f x * ZMod.stdAddChar (-(x.1 * k.1 + x.2 * k.2))

/-
Definitions of geometric regions (diagonal, above, below) and support of a function on these regions.
-/
def to_grid {N : ℕ} (x : Fin N × Fin N) : ZMod N × ZMod N := (x.1, x.2)

def is_diagonal {N : ℕ} (x : Fin N × Fin N) : Prop := x.1 = x.2
def is_above_diagonal {N : ℕ} (x : Fin N × Fin N) : Prop := x.1 < x.2
def is_below_diagonal {N : ℕ} (x : Fin N × Fin N) : Prop := x.1 > x.2

def supported_on {N : ℕ} (f : ZMod N × ZMod N → ℂ) (P : Fin N × Fin N → Prop) : Prop :=
  ∀ x : Fin N × Fin N, ¬P x → f (to_grid x) = 0

/-
Every point in Fin N x Fin N is either above, below, or on the diagonal.
-/
lemma trichotomy_fin {N : ℕ} (x : Fin N × Fin N) :
    is_above_diagonal x ∨ is_below_diagonal x ∨ is_diagonal x := by
  rcases x with ⟨i, j⟩
  simp [is_above_diagonal, is_below_diagonal, is_diagonal]
  rcases lt_trichotomy i j with h | h | h
  · left; exact h
  · right; right; exact h
  · right; left; exact h

/-
The mapping to_grid is surjective.
-/
lemma to_grid_surjective {N : ℕ} [NeZero N] : Function.Surjective (@to_grid N) := by
  rintro ⟨ x, y ⟩;
  rcases N with ( _ | _ | N ) <;> norm_num [ ZMod ] at *;
  · fin_cases x ; fin_cases y ; trivial;
  · exact ⟨ ⟨ x.val, by linarith [ x.val_lt ] ⟩, ⟨ y.val, by linarith [ y.val_lt ] ⟩, by simp +decide [ to_grid ] ⟩

/-
Claim A (Separability): Functions supported on above/below/diagonal are linearly independent.
-/
theorem disjoint_supports_implies_zero_sum {N : ℕ} [NeZero N] (f g h : ZMod N × ZMod N → ℂ)
    (hf : supported_on f (is_above_diagonal))
    (hg : supported_on g (is_below_diagonal))
    (hh : supported_on h (is_diagonal))
    (h_sum : ∀ x, f x + g x = h x) :
    f = 0 ∧ g = 0 ∧ h = 0 := by
      refine' ⟨ funext fun x => _, funext fun x => _, funext fun x => _ ⟩;
      · by_cases hx : x.1.val < x.2.val <;> by_cases hx' : x.1.val > x.2.val <;> simp_all +decide [ supported_on ];
        · exact False.elim <| lt_asymm hx hx';
        · contrapose! hf;
          have := h_sum x.1 x.2; specialize hg ( ⟨ x.1.val, by linarith [ x.1.val_lt ] ⟩ : Fin N ) ( ⟨ x.2.val, by linarith [ x.2.val_lt ] ⟩ : Fin N ) ; simp_all +decide [ is_below_diagonal, is_above_diagonal ] ;
          specialize h_sum x.1 x.2; simp_all +decide [ is_diagonal ] ;
          specialize hh ⟨ x.1.val, by linarith [ x.1.val_lt ] ⟩ ⟨ x.2.val, by linarith [ x.2.val_lt ] ⟩ ; simp_all +decide [ to_grid ] ;
        · convert hf ⟨ x.1.val, _ ⟩ ⟨ x.2.val, _ ⟩ _;
          all_goals try { exact ZMod.val_lt _ };
          · exact Prod.ext ( Eq.symm <| ZMod.natCast_zmod_val _ ) ( Eq.symm <| ZMod.natCast_zmod_val _ );
          · exact fun h => hx'.not_le h.le;
        · convert hf ⟨ x.1.val, by
            exact ZMod.val_lt _ ⟩ ⟨ x.2.val, by
            exact ZMod.val_lt _ ⟩ _
          generalize_proofs at *;
          · exact Prod.ext ( by exact Eq.symm ( ZMod.natCast_zmod_val x.1 ) ) ( by exact Eq.symm ( ZMod.natCast_zmod_val x.2 ) );
          · exact fun h => by linarith [ show x.1.val < x.2.val from h ] ;
      · by_cases hx : x.1 = x.2 <;> simp_all +decide [ supported_on ];
        · convert hg ⟨ x.1.val, _ ⟩ ⟨ x.2.val, _ ⟩ _;
          all_goals norm_num [ is_below_diagonal, hx ];
          all_goals norm_num [ hx, to_grid ];
          · exact Prod.ext hx rfl;
          · exact ZMod.val_lt _;
          · exact ZMod.val_lt _;
        · contrapose! hg;
          use ⟨ x.1.val, by
            exact ZMod.val_lt _ ⟩, ⟨ x.2.val, by
            exact ZMod.val_lt _ ⟩
          generalize_proofs at *;
          simp_all +decide [ is_below_diagonal, is_above_diagonal, to_grid ];
          specialize h_sum x.1 x.2 ; specialize hf ⟨ x.1.val, by assumption ⟩ ⟨ x.2.val, by assumption ⟩ ; specialize hh ⟨ x.1.val, by assumption ⟩ ⟨ x.2.val, by assumption ⟩ ; simp_all +decide [ is_diagonal ] ;
          grind +ring;
      · by_cases hx : x.1 = x.2 <;> simp_all +decide [ supported_on ];
        · contrapose! h_sum; simp_all +decide [ is_above_diagonal, is_below_diagonal, is_diagonal ] ;
          use x.1, x.2; simp_all +decide [ to_grid ] ;
          rw [ show x = ( x.2, x.2 ) by aesop ] at h_sum; specialize hf ⟨ x.2.val, by linarith [ x.2.val_lt ] ⟩ ⟨ x.2.val, by linarith [ x.2.val_lt ] ⟩ ; specialize hg ⟨ x.2.val, by linarith [ x.2.val_lt ] ⟩ ⟨ x.2.val, by linarith [ x.2.val_lt ] ⟩ ; aesop;
        · -- Since $x.1 \neq x.2$, we can find $a, b \in \text{Fin } N$ such that $x = \text{to\_grid } (a, b)$.
          obtain ⟨a, b, hab⟩ : ∃ a b : Fin N, x = to_grid (a, b) := by
            cases to_grid_surjective x ; aesop;
          cases lt_or_gt_of_ne ( show a ≠ b from by rintro rfl; exact hx <| by simp +decide [ hab, to_grid ] ) <;> simp_all +decide [ is_above_diagonal, is_below_diagonal, is_diagonal ];
          · exact hh a b ( ne_of_lt ‹_› );
          · exact hh _ _ ( ne_of_gt ‹_› )

/-
Definition of the diagonal indicator function and the anti-diagonal region.
-/
def diagonal_indicator {N : ℕ} : ZMod N × ZMod N → ℂ :=
  fun x => if x.1 = x.2 then 1 else 0

def is_anti_diagonal {N : ℕ} (k : ZMod N × ZMod N) : Prop := k.1 + k.2 = 0

/-
The sum of the standard additive character weighted by a non-zero constant c over ZMod N is zero.
-/
lemma dft_diagonal_helper {N : ℕ} [NeZero N] (c : ZMod N) (hc : c ≠ 0) :
  ∑ x : ZMod N, ZMod.stdAddChar (x * c) = 0 := by
    -- By multiplying each term in the sum by the character of $c$, we obtain the same sum, but shifted by $c$.
    have h_shift : ∑ x : ZMod N, ZMod.stdAddChar (x * c) = ∑ x : ZMod N, ZMod.stdAddChar ((x + 1) * c) := by
      rw [ ← Equiv.sum_comp ( Equiv.addRight 1 ) ] ; norm_num;
    simp_all +decide [ add_mul, ZMod.stdAddChar.map_add_eq_mul ];
    by_cases h : ∑ x : ZMod N, ZMod.stdAddChar ( x * c ) = 0 <;> simp_all +decide [ ← Finset.sum_mul _ _ _ ];
    -- Since $ZMod.stdAddChar c = 1$, this implies that $c$ is a multiple of $N$, contradicting $c \neq 0$.
    have h_contra : c.val % N = 0 := by
      have h_contra : Complex.exp (2 * Real.pi * Complex.I * c.val / N) = 1 := by
        convert h_shift using 1;
        simp +decide [ ZMod.stdAddChar, mul_div_assoc ];
        simp +decide [ ZMod.toCircle, Complex.exp_nat_mul ];
        simp +decide [ ZMod.toAddCircle, AddCircle.toCircle_addChar ];
        erw [ QuotientAddGroup.mk'_apply ] ; norm_num [ Complex.exp_nat_mul, mul_div_cancel₀ ];
        erw [ AddCircle.toCircle ] ; norm_num [ Complex.exp_nat_mul, mul_div_cancel₀ ];
        norm_num [ mul_assoc, mul_comm, mul_left_comm ];
        cases N <;> aesop;
      rw [ Complex.exp_eq_one_iff ] at h_contra;
      obtain ⟨ n, hn ⟩ := h_contra; rw [ div_eq_iff ( Nat.cast_ne_zero.mpr <| NeZero.ne N ) ] at hn; norm_num [ Complex.ext_iff ] at hn;
      rw [ ← Int.natCast_inj ] ; simp_all +decide [ ZMod.val ];
      rcases N with ( _ | _ | N ) <;> simp_all +decide [ ZMod.cast, ZMod.val ];
      exact ⟨ n, by rw [ ← @Int.cast_inj ℝ ] ; push_cast; nlinarith [ Real.pi_pos ] ⟩;
    exact hc ( by rw [ ← ZMod.val_eq_zero ] ; exact Nat.eq_zero_of_dvd_of_lt ( Nat.dvd_of_mod_eq_zero h_contra ) ( ZMod.val_lt c ) )

/-
Claim C (Diagonal Transform): The DFT of the diagonal indicator is supported on the anti-diagonal.
-/
theorem dft_diagonal_is_anti_diagonal {N : ℕ} [NeZero N] :
    supported_on (dft2 (@diagonal_indicator N)) (fun k => is_anti_diagonal (to_grid k)) := by
      unfold supported_on dft2 diagonal_indicator;
      intro x hx; erw [ Finset.sum_product ] ; simp_all +decide [ is_anti_diagonal ] ;
      -- Let $c = -(to_grid x).1 - (to_grid x).2$. Since $(to_grid x).1 + (to_grid x).2 \neq 0$, we have $c \neq 0$.
      set c : ZMod N := -(to_grid x).1 - (to_grid x).2
      have hc : c ≠ 0 := by
        grind;
      convert dft_diagonal_helper c hc using 2 ; ring!;

/-
Claim C (Diagonal Transform): The DFT of the diagonal indicator is supported on the anti-diagonal.
-/
theorem dft_diagonal_is_anti_diagonal_theorem {N : ℕ} [NeZero N] :
    supported_on (dft2 (@diagonal_indicator N)) (fun k => is_anti_diagonal (to_grid k)) := by
      -- Apply the hypothesis `h_dft_diagonal` to the assumption that `k` is not on the anti-diagonal.
      apply dft_diagonal_is_anti_diagonal

/-
Claim C (Diagonal Transform): The DFT of the diagonal indicator is supported on the anti-diagonal.
-/
theorem dft_diagonal_is_anti_diagonal_v2 {N : ℕ} [NeZero N] :
    supported_on (dft2 (@diagonal_indicator N)) (fun k => is_anti_diagonal (to_grid k)) := by
      -- Apply the theorem that states the DFT of the diagonal indicator is supported on the anti-diagonal.
      apply dft_diagonal_is_anti_diagonal_theorem

/-
Claim B (Babinet Sign-Depth Correspondence): The DFT of a pattern plus the DFT of its complement equals the DFT of the full aperture.
-/
def full_aperture {N : ℕ} : ZMod N × ZMod N → ℂ := fun _ => 1

def complement {N : ℕ} (f : ZMod N × ZMod N → ℂ) : ZMod N × ZMod N → ℂ :=
  fun x => full_aperture x - f x

theorem babinet_principle {N : ℕ} [NeZero N] (f : ZMod N × ZMod N → ℂ) :
    dft2 f + dft2 (complement f) = dft2 (@full_aperture N) := by
  ext k
  simp [dft2, complement, full_aperture]
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro x _
  ring

/-
Checking Fintype instances.
-/
#synth Fintype (ZMod 5)
#synth Fintype (ZMod 5 × ZMod 5)

/-
Claim D (Coherent Non-Cancellation): If the magnitude of the positive and negative content differs, the signals cannot cancel.
-/
noncomputable def content {N : ℕ} [NeZero N] (f : ZMod N × ZMod N → ℂ) : ℝ := ∑ x, ‖f x‖

theorem signed_spectral_gap {N : ℕ} [NeZero N] (f g : ZMod N × ZMod N → ℂ)
    (hf : supported_on f (is_above_diagonal))
    (hg : supported_on g (is_below_diagonal))
    (h_diff : content f ≠ content g) :
    f + g ≠ 0 := by
  intro h_zero
  have h_sum : ∀ x, f x + g x = 0 := by
    intro x
    have : (f + g) x = 0 := by rw [h_zero]; simp
    simp at this
    exact this
  have h_split : f = 0 ∧ g = 0 ∧ (0 : ZMod N × ZMod N → ℂ) = 0 :=
    disjoint_supports_implies_zero_sum f g 0 hf hg (fun _ _ => rfl) (fun x => by simp; exact h_sum x)
  have hf0 : f = 0 := h_split.1
  have hg0 : g = 0 := h_split.2.1
  rw [hf0, hg0] at h_diff
  simp [content] at h_diff